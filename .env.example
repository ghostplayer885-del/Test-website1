# Example environment variables for the AQrix tournament website
# Copy this file to .env and set your own secrets for production

# JWT secret used for admin login / session tokens
JWT_SECRET=your_strong_jwt_secret_here

# Admin credentials
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_strong_admin_password_here

# Database connection URL
DATABASE_URL=mysql://username:password@localhost:3306/your_database

# Other environment variables used by the project
OWNER_OPEN_ID=your_owner_openid
OAUTH_SERVER_URL=https://your-oauth-server.example.com
BUILT_IN_FORGE_API_URL=https://your-forge-api.example.com
BUILT_IN_FORGE_API_KEY=your_forge_api_key_here
NODE_ENV=development
